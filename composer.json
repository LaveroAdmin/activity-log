{
    "name": "laveroadmin/activity-log",
    "description": "Eloquent models activity log and audit trail extension for LaveroAdmin",
    "type": "library",
    "keywords": [
        "lavero-admin",
        "activity-log",
        "audit",
        "spatie",
        "audit-trail"
    ],
    "homepage": "https://bespredel.name",
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksandr Kireev",
            "email": "hello@bespredel.name",
            "homepage": "https://bespredel.name"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laveroadmin/laveroadmin": "^1.0",
        "spatie/laravel-activitylog": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "LaveroAdmin\\Admin\\ActivityLog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaveroAdmin\\Admin\\ActivityLog\\ActivityLogServiceProvider"
            ]
        }
    }
}
